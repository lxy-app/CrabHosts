export global Theme {
    in-out property <bool> light: false;
    in property <bool> reduce-motion: false;
    out property <color> window: light ? #f2f1ec : #111210;
    out property <color> sidebar: light ? #e9eae3 : #171815;
    out property <color> titlebar: light ? #e7e8e1 : #151613;
    out property <color> surface: light ? #faf9f5 : #1b1c19;
    out property <color> raised: light ? #f0f0e9 : #20211e;
    out property <color> hover: light ? #e3e6dd : #272824;
    out property <color> selected: light ? #d9e2d6 : #2b2c27;
    out property <color> field: light ? #fdfcf8 : #151613;
    out property <color> border: light ? #babeb3 : #31322d;
    out property <color> border-soft: light ? #d6d8ce : #282924;
    out property <color> text: light ? #242a24 : #f0eee7;
    out property <color> text-soft: light ? #424b41 : #c8c6bd;
    out property <color> muted: light ? #596256 : #97988f;
    out property <color> faint: light ? #687062 : #6f7169;
    out property <color> ivory: light ? #394d3d : #e9e6dc;
    out property <color> action: light ? #e0eadf : #34443a;
    out property <color> action-hover: light ? #d1e0d0 : #405247;
    out property <color> apply: light ? #445f49 : #405447;
    out property <color> apply-text: light ? #f5f7f0 : action-text;
    out property <color> apply-hover: light ? #38523d : #495f50;
    out property <color> action-border: light ? #849986 : #586c5c;
    out property <color> action-text: light ? #263c2c : #e0e7de;
    out property <color> secondary: light ? #eeefe8 : #252722;
    out property <color> secondary-border: light ? #b6bcb0 : #454840;
    out property <color> secondary-text: light ? #384336 : #cfd1c7;
    out property <color> disabled: light ? #e6e7df : #292c28;
    out property <color> disabled-text: light ? #62695f : #969c92;
    out property <color> switch-on: light ? #526f57 : #526b59;
    out property <color> switch-thumb: light ? #f1f6ed : #d8e1d5;
    out property <color> ivory-ink: light ? #f7f9f2 : #20211e;
    out property <color> sage: light ? #50694f : #a8b7a1;
    out property <color> sage-soft: light ? #e3ebdf : #263027;
    out property <color> danger: light ? #8b443b : #d5a59b;
    out property <color> danger-soft: light ? #f4e7e1 : #332625;
    out property <color> focus: light ? #466c4b : #9eb29e;
}
