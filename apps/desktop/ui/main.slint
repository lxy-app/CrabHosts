import { ListView, Palette, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { SettingsView } from "settings.slint";

export struct ProfileData {
    name: string,
    entry-count: int,
    selected: bool,
}

export struct EntryData {
    address: string,
    hostnames: string,
    enabled: bool,
    comment: string,
}

export struct PreviewLineData {
    text: string,
    line-number: int,
    kind: string,
}

component CenteredControl inherits VerticalLayout {
    alignment: center;
    @children
}

component AppButton inherits FocusScope {
    in property <string> text;
    in property <string> accessible-name;
    in property <image> icon;
    in property <bool> show-icon: false;
    in property <string> kind: "secondary";
    in property <bool> small: false;
    in property <length> button-height: root.small ? 32px : 38px;
    in property <length> min-button-width: 0px;
    callback clicked();

    property <bool> emphasized: root.kind == "primary" || root.kind == "apply";
    width: max(root.min-button-width, layout.preferred-width);
    height: root.button-height;
    accessible-role: button;
    accessible-label: root.accessible-name == "" ? root.text : root.accessible-name;
    accessible-action-default => {
        if (root.enabled) {
            root.clicked();
        }
    }

    key-pressed(event) => {
        if (root.enabled && (event.text == Key.Return || event.text == " ")) {
            root.clicked();
            accept
        } else {
            reject
        }
    }

    background := Rectangle {
        border-radius: root.small ? 8px : 9px;
        border-width: root.has-focus ? 2px : 1px;
        border-color: !root.enabled ? Theme.border : root.has-focus ? Theme.focus :
            root.emphasized ? Theme.action-border :
            root.kind == "danger" && touch.has-hover ? Theme.danger : Theme.secondary-border;
        background: !root.enabled ? Theme.disabled :
            root.kind == "apply" ? (touch.has-hover ? Theme.apply-hover : Theme.apply) :
            root.emphasized ? (touch.has-hover ? Theme.action-hover : Theme.action) :
            root.kind == "danger" && touch.has-hover ? Theme.danger-soft :
            root.kind == "quiet" ? transparent :
            touch.has-hover ? Theme.hover : Theme.secondary;
        animate background, border-color { duration: Theme.reduce-motion ? 0ms : 160ms; }

        touch := TouchArea {
            enabled: root.enabled;
            clicked => root.clicked();
        }

        layout := HorizontalLayout {
            padding-left: root.small ? 11px : 14px;
            padding-right: root.small ? 11px : 14px;
            spacing: 7px;
            alignment: center;
            if root.show-icon : Rectangle {
                width: 15px;
                height: root.button-height;
                Image {
                    source: root.icon;
                    width: 15px;
                    height: 15px;
                    y: (parent.height - self.height) / 2;
                    image-fit: contain;
                    colorize: !root.enabled ? Theme.disabled-text :
                        root.kind == "apply" ? Theme.apply-text : root.emphasized ? Theme.action-text :
                        root.kind == "danger" ? Theme.danger : Theme.secondary-text;
                }
            }
            Text {
                text: root.text;
                color: !root.enabled ? Theme.disabled-text :
                    root.kind == "apply" ? Theme.apply-text : root.emphasized ? Theme.action-text :
                    root.kind == "danger" ? (touch.has-hover ? Theme.danger : Theme.danger) :
                    touch.has-hover ? Theme.text : Theme.secondary-text;
                font-size: root.small ? 12px : 13px;
                font-weight: root.emphasized ? 650 : 500;
                vertical-alignment: center;
            }
        }
    }
}

component IconButton inherits FocusScope {
    in property <image> icon;
    in property <string> accessible-name;
    in property <length> button-size: 34px;
    in property <length> icon-size: 17px;
    in property <bool> danger: false;
    callback clicked();

    width: root.button-size;
    height: root.button-size;
    accessible-role: button;
    accessible-label: root.accessible-name;
    accessible-action-default => {
        if (root.enabled) {
            root.clicked();
        }
    }

    key-pressed(event) => {
        if (root.enabled && (event.text == Key.Return || event.text == " ")) {
            root.clicked();
            accept
        } else {
            reject
        }
    }

    Rectangle {
        border-radius: root.button-size == 30px ? 7px : 8px;
        border-width: root.has-focus ? 2px : 1px;
        border-color: root.has-focus ? Theme.focus : touch.has-hover && !root.danger ? Theme.border : transparent;
        background: touch.has-hover ? (root.danger ? Theme.danger-soft : Theme.hover) : transparent;
        opacity: root.enabled ? 1 : 0.45;
        animate background, border-color { duration: Theme.reduce-motion ? 0ms : 160ms; }

        touch := TouchArea {
            enabled: root.enabled;
            clicked => root.clicked();
        }
        Image {
            source: root.icon;
            width: root.icon-size;
            height: root.icon-size;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            image-fit: contain;
            colorize: root.danger ? (touch.has-hover ? Theme.danger : Theme.faint) :
                touch.has-hover ? Theme.text : Theme.text-soft;
        }
    }
}

component FieldInput inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <string> accessible-name;
    in property <bool> mono: false;
    callback submitted();

    height: 40px;
    border-radius: 8px;
    border-width: input.has-focus ? 2px : 1px;
    border-color: input.has-focus ? Theme.focus : touch.has-hover ? Theme.secondary-border : Theme.border;
    background: input.has-focus ? Theme.field : Theme.field;
    forward-focus: input;

    touch := TouchArea {
        clicked => input.focus();
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        input := TextInput {
            text <=> root.text;
            color: Theme.text;
            font-size: 13px;
            font-family: root.mono ? "SF Mono" : "";
            vertical-alignment: center;
            horizontal-alignment: left;
            accessible-label: root.accessible-name;
            accepted => root.submitted();
        }
    }
    if root.text == "" : HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        Text {
            text: root.placeholder;
            color: Theme.faint;
            font-size: 13px;
            font-family: root.mono ? "SF Mono" : "";
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

component AppCheckBox inherits FocusScope {
    in-out property <bool> checked;
    in property <string> label;
    in property <string> description;
    height: root.description == "" ? 22px : 46px;
    accessible-role: checkbox;
    accessible-label: root.label;
    accessible-checked: root.checked;
    accessible-action-default => { root.checked = !root.checked; }

    key-pressed(event) => {
        if (event.text == Key.Return || event.text == " ") {
            root.checked = !root.checked;
            accept
        } else {
            reject
        }
    }

    TouchArea { clicked => { root.checked = !root.checked; } }
    HorizontalLayout {
        spacing: 10px;
        Rectangle {
            width: 16px;
            height: 16px;
            y: 2px;
            border-radius: 4px;
            border-width: root.has-focus ? 2px : 1px;
            border-color: root.has-focus ? Theme.focus : root.checked ? Theme.ivory : Theme.border;
            background: root.checked ? Theme.ivory : Theme.field;
            if root.checked : Image {
                source: @image-url("assets/check.svg");
                width: 12px;
                height: 12px;
                x: 1px;
                y: 1px;
                colorize: Theme.ivory-ink;
            }
        }
        VerticalLayout {
            spacing: 3px;
            Text {
                text: root.label;
                color: Theme.text-soft;
                font-size: 13px;
                font-weight: 500;
            }
            if root.description != "" : Text {
                text: root.description;
                color: Theme.muted;
                font-size: 12px;
                wrap: word-wrap;
            }
        }
    }
}

component EntrySwitch inherits FocusScope {
    in property <bool> on;
    in property <string> accessible-name;
    callback clicked();
    width: 34px;
    height: 20px;
    accessible-role: checkbox;
    accessible-label: root.accessible-name;
    accessible-checked: root.on;
    accessible-action-default => root.clicked();

    key-pressed(event) => {
        if (event.text == Key.Return || event.text == " ") {
            root.clicked();
            accept
        } else {
            reject
        }
    }

    Rectangle {
        width: 34px;
        height: 20px;
        border-radius: 12px;
        border-width: root.has-focus ? 2px : 1px;
        border-color: root.has-focus ? Theme.focus : root.on ? Theme.action-border : Theme.secondary-border;
        background: root.on ? Theme.switch-on : Theme.disabled;
        TouchArea { clicked => root.clicked(); }
        Rectangle {
            width: 12px;
            height: 12px;
            x: root.on ? 18px : 3px;
            y: 3px;
            border-radius: 6px;
            background: root.on ? Theme.switch-thumb : Theme.muted;
            animate x { duration: Theme.reduce-motion ? 0ms : 160ms; }
        }
    }
}

component ProfileRow inherits FocusScope {
    in property <string> profile-name;
    in property <int> entry-count;
    in property <bool> selected;
    in property <bool> compact: false;
    in property <bool> show-counts: true;
    callback clicked();
    accessible-role: button;
    accessible-label: root.profile-name + (root.show-counts ? "，" + root.entry-count + " 条记录" : "");
    accessible-action-default => root.clicked();

    key-pressed(event) => {
        if (event.text == Key.Return || event.text == " ") {
            root.clicked();
            accept
        } else {
            reject
        }
    }

    Rectangle {
        height: root.compact ? 54px : 62px;
        border-radius: 10px;
        border-width: root.has-focus || root.selected ? 1px : 0px;
        border-color: root.has-focus ? Theme.focus : root.selected ? Theme.border : transparent;
        background: root.selected ? Theme.selected : touch.has-hover ? Theme.raised : transparent;
        animate background { duration: Theme.reduce-motion ? 0ms : 160ms; }

        touch := TouchArea { clicked => root.clicked(); }
        if root.selected : Rectangle {
            x: 0px;
            y: 17px;
            width: 2px;
            height: 26px;
            border-radius: 2px;
            background: Theme.ivory;
        }
        HorizontalLayout {
            padding-top: 9px;
            padding-bottom: 9px;
            padding-left: 10px;
            padding-right: 10px;
            spacing: 10px;
            Rectangle {
                width: 34px;
                height: 34px;
                border-radius: 9px;
                border-width: 1px;
                border-color: root.selected ? Theme.secondary-border : Theme.border;
                background: root.selected ? Theme.disabled : Theme.raised;
                Image {
                    source: @image-url("assets/folder.svg");
                    width: 15px;
                    height: 15px;
                    x: 8px;
                    y: 8px;
                    colorize: root.selected ? Theme.ivory : Theme.muted;
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 4px;
                Text {
                    text: root.profile-name;
                    color: root.selected ? Theme.text : Theme.text-soft;
                    font-size: 14px;
                    font-weight: 600;
                    overflow: elide;
                }
                if root.show-counts : Text {
                    text: root.entry-count + " 条记录";
                    color: Theme.muted;
                    font-size: 12px;
                }
            }
            if root.selected : Rectangle {
                width: 10px;
                height: 34px;
                Rectangle {
                    width: 6px;
                    height: 6px;
                    x: 0px;
                    y: 14px;
                    border-radius: 3px;
                    background: Theme.sage;
                }
            }
        }
    }
}

component Segment inherits FocusScope {
    in property <string> text;
    in property <bool> active;
    callback clicked();
    height: 29px;
    width: text-layout.preferred-width + 22px;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => root.clicked();
    key-pressed(event) => {
        if (event.text == Key.Return || event.text == " ") {
            root.clicked();
            accept
        } else {
            reject
        }
    }
    Rectangle {
        border-radius: 6px;
        border-width: root.has-focus ? 1px : 0px;
        border-color: Theme.focus;
        background: root.active ? Theme.selected : transparent;
        TouchArea { clicked => root.clicked(); }
        text-layout := Text {
            text: root.text;
            color: root.active ? Theme.text : Theme.muted;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

component ModalFooter inherits Rectangle {
    height: 70px;
    background: Theme.surface;
    Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 1px;
        background: Theme.border-soft;
    }
    HorizontalLayout {
        padding: 16px;
        padding-left: 24px;
        padding-right: 24px;
        alignment: end;
        spacing: 9px;
        @children
    }
}

component ModalFrame inherits FocusScope {
    in property <string> title;
    in property <string> kicker: "CrabHosts";
    in property <bool> wide: false;
    callback close();
    width: 100%;
    height: 100%;
    init => root.focus();
    key-pressed(event) => {
        if (event.text == Key.Escape) {
            root.close();
            accept
        } else {
            reject
        }
    }

    Rectangle {
        width: 100%;
        height: 100%;
        background: #050605a8;
        TouchArea { clicked => root.close(); }
        HorizontalLayout {
            width: 100%;
            height: 100%;
            padding: 24px;
            alignment: center;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: min(root.wide ? 720px : 460px, root.width - 48px);
                    height: min(root.height - 48px, modal-layout.preferred-height);
                    border-radius: 16px;
                    border-width: 1px;
                    border-color: Theme.border;
                    background: Theme.surface;
                    clip: true;
                    drop-shadow-blur: 70px;
                    drop-shadow-color: #0000006b;
                    drop-shadow-offset-y: 24px;
                    TouchArea {}
                    modal-layout := VerticalLayout {
                        width: 100%;
                        spacing: 0;
                        HorizontalLayout {
                            padding-top: 23px;
                            padding-left: 24px;
                            padding-right: 24px;
                            spacing: 16px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 7px;
                                Text {
                                    text: root.kicker;
                                    color: Theme.muted;
                                    font-size: 11px;
                                    font-weight: 600;
                                }
                                Text {
                                    text: root.title;
                                    color: Theme.text;
                                    font-size: 20px;
                                    font-weight: 650;
                                    wrap: word-wrap;
                                }
                            }
                            IconButton {
                                icon: @image-url("assets/close.svg");
                                accessible-name: "关闭";
                                clicked => root.close();
                            }
                        }
                        @children
                    }
                }
            }
        }
    }
}

component SummaryCell inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <bool> mono: false;
    height: 64px;
    border-radius: 9px;
    border-width: 1px;
    border-color: Theme.border-soft;
    background: Theme.sidebar;
    VerticalLayout {
        padding-top: 10px;
        padding-bottom: 10px;
        padding-left: 13px;
        padding-right: 13px;
        spacing: 4px;
        Text { text: root.label; color: Theme.muted; font-size: 11px; }
        Text {
            text: root.value;
            color: Theme.text;
            font-size: 15px;
            font-weight: 600;
            font-family: root.mono ? "SF Mono" : "";
            overflow: elide;
        }
    }
}

component CheckLine inherits HorizontalLayout {
    in property <string> text;
    spacing: 9px;
    Image {
        source: @image-url("assets/check.svg");
        width: 15px;
        height: 15px;
        y: 2px;
        colorize: Theme.sage;
    }
    Text {
        text: root.text;
        color: Theme.text-soft;
        font-size: 12px;
        wrap: word-wrap;
        horizontal-stretch: 1;
    }
}

export component CrabHostsTray inherits SystemTrayIcon {
    in property <[ProfileData]> profiles;
    in property <string> selected-name;
    in property <string> applied-name;
    in property <bool> show-tray: true;
    in-out property <image> tray-icon;
    in property <image> tray-icon-on-dark;
    icon: Palette.color-scheme == ColorScheme.dark ? root.tray-icon-on-dark : root.tray-icon;
    tooltip: "CrabHosts · Profile 管理";
    visible: root.show-tray;

    callback open-main();
    callback open-settings();
    callback profile-selected(int);
    callback apply-current();
    callback quit();

    Menu {
        MenuItem {
            title: "打开 CrabHosts";
            activated => root.open-main();
        }
        MenuItem {
            title: "设置…";
            activated => root.open-settings();
        }
        MenuSeparator {}
        if root.applied-name != "" : MenuItem {
            title: "本次已应用：" + root.applied-name;
            enabled: false;
        }
        MenuItem {
            title: "切换编辑 Profile（不会写入系统）";
            enabled: false;
        }
        for profile[index] in root.profiles : MenuItem {
            title: (profile.selected ? "✓ " : "") + profile.name + " · " + profile.entry-count + " 条";
            activated => root.profile-selected(index);
        }
        MenuSeparator {}
        MenuItem {
            title: root.selected-name == "" ? "应用当前 Profile…" : "应用「" + root.selected-name + "」…";
            enabled: root.selected-name != "";
            activated => root.apply-current();
        }
        MenuSeparator {}
        MenuItem {
            title: "退出 CrabHosts";
            activated => root.quit();
        }
    }
}

export component MainWindow inherits Window {
    title: "CrabHosts";
    icon: @image-url("assets/app-icon.png");
    preferred-width: 1080px;
    preferred-height: 760px;
    min-width: 900px;
    min-height: 620px;
    background: Theme.window;

    in property <[ProfileData]> profiles;
    in property <[EntryData]> entries;
    in property <[PreviewLineData]> preview-lines;
    in property <string> selected-name;
    in property <int> selected-enabled-count;
    in property <string> status;
    in property <string> panel-text;
    in property <string> panel-label;
    in property <string> panel-stats: "";
    in property <int> panel-line-count: 0;
    in property <string> system-hosts-path;
    in property <string> helper-status-text;
    in property <string> helper-state: "direct";
    in property <bool> helper-busy: false;
    in-out property <string> current-view: "profiles";
    in-out property <int> settings-section: 0;
    in property <bool> pref-launch-at-login: false;
    in property <bool> pref-show-tray: true;
    in property <string> pref-close-action: "tray";
    in-out property <bool> pref-light <=> Theme.light;
    in property <string> pref-density: "comfortable";
    in property <bool> pref-show-profile-counts: true;
    in property <bool> pref-reduce-motion: false;
    in property <int> pref-backup-retention: 20;
    in property <string> backup-path;
    in property <string> app-version;
    in property <string> login-item-status: "not-installed";
    in-out property <string> create-error;
    in-out property <int> panel-mode: 0;
    in-out property <bool> show-preview-viewer: false;
    in-out property <bool> viewer-opened: false;
    in-out property <bool> preview-wrap: false;
    in-out property <bool> preview-gutter: true;
    in-out property <bool> show-create: false;
    in-out property <bool> show-delete-confirm: false;
    in-out property <bool> show-remove-entry: false;
    in-out property <bool> show-import-confirm: false;
    in-out property <bool> show-confirm: false;
    in-out property <bool> show-helper-install: false;
    in-out property <bool> show-safety: false;
    in-out property <bool> show-reset-preferences: false;
    in-out property <int> pending-entry: -1;
    in-out property <string> new-profile-name;
    in-out property <bool> import-from-system;
    in-out property <string> draft-ip;
    in-out property <string> draft-hostnames;
    in-out property <string> draft-comment;
    in-out property <string> toast-text;
    in-out property <bool> toast-visible: false;

    callback refresh();
    callback profile-selected(int);
    callback create-profile(string, bool);
    callback delete-profile();
    callback preview-selected();
    callback request-apply();
    callback apply-selected();
    callback apply-cancelled();
    in property <bool> selected-in-sync;
    pure callback valid-entry(string, string, string) -> bool;
    out property <bool> draft-valid: root.valid-entry(root.draft-ip, root.draft-hostnames, root.draft-comment);
    function submit-entry() {
        if (root.draft-valid) {
            root.add-entry(root.draft-ip, root.draft-hostnames, root.draft-comment);
        }
    }
    callback add-entry(string, string, string);
    callback toggle-entry(int);
    callback remove-entry(int);
    callback import-selected-from-system();
    callback load-system-hosts();
    callback copy-preview();
    callback install-helper();
    callback preference-changed(string, string);
    callback open-backups();
    callback reset-preferences();
    callback apply-finished();

    property <bool> density-compact: root.pref-density == "compact";
    init => {
        Theme.reduce-motion = root.pref-reduce-motion;
        Palette.color-scheme = root.pref-light ? ColorScheme.light : ColorScheme.dark;
    }
    changed pref-light => { Palette.color-scheme = root.pref-light ? ColorScheme.light : ColorScheme.dark; }
    changed pref-reduce-motion => { Theme.reduce-motion = root.pref-reduce-motion; }
    property <length> viewport-width: 1080px;
    property <length> viewport-height: 760px;
    changed width => { root.viewport-width = root.width; }
    changed height => { root.viewport-height = root.height; }
    property <bool> compact-width: root.viewport-width <= 1120px;
    property <bool> compact-height: root.viewport-height <= 760px;
    property <length> sidebar-width: root.compact-width ? 224px : 258px;
    property <length> content-gap: root.density-compact ? 12px : root.compact-width ? 13px : 16px;
    property <length> preview-height: root.compact-height ? 232px : 272px;
    property <int> preview-inline-lines: root.compact-height ? 6 : 8;
    function open-preview-viewer() {
        root.viewer-opened = true;
        root.show-preview-viewer = true;
    }
    function close-preview-viewer() {
        root.show-preview-viewer = false;
    }
    property <length> entries-min-height: root.compact-height ? 190px : 230px;
    property <length> content-padding-top: root.compact-width ? 22px : 26px;
    property <length> content-padding-bottom: root.compact-width ? 16px : 18px;
    property <length> entries-height: max(root.entries-min-height,
        root.viewport-height - 52px - root.content-padding-top - root.content-padding-bottom -
        54px - 126px - root.preview-height - 20px - 4 * root.content-gap);
    property <length> content-height: root.content-padding-top + root.content-padding-bottom +
        54px + root.entries-height + 126px + root.preview-height + 20px + 4 * root.content-gap;
    property <bool> modal-open: root.show-create || root.show-delete-confirm || root.show-remove-entry ||
        root.show-import-confirm || root.show-confirm || root.show-helper-install || root.show-safety ||
        root.show-reset-preferences;
    property <bool> helper-mode: root.helper-state != "direct" && root.helper-state != "unsupported";
    property <bool> helper-actionable: root.helper-state == "not_installed" || root.helper-state == "requires_approval" || root.helper-state == "unavailable";
    property <bool> apply-allowed: !root.helper-busy && (root.helper-state == "direct" || root.helper-state == "ready");
    property <string> helper-display-text: root.helper-status-text != "" ? root.helper-status-text :
        root.helper-state == "checking" ? "正在检查系统写入 Helper…" :
        root.helper-state == "ready" ? "系统写入 Helper 已就绪" :
        root.helper-state == "not_installed" ? "系统写入 Helper 未安装" :
        root.helper-state == "requires_approval" ? "Helper 需要安装或更新授权" :
        root.helper-state == "unavailable" ? "系统写入 Helper 不可用" :
        root.helper-state == "unsupported" ? "当前平台不支持 Helper" : "直接写入（测试/演示）";
    property <string> pending-entry-summary: root.pending-entry >= 0 && root.pending-entry < root.entries.length ?
        root.entries[root.pending-entry].address + " " + root.entries[root.pending-entry].hostnames : "";

    MenuBar {
        Menu {
            title: "CrabHosts";
            MenuItem {
                title: "设置…";
                shortcut: @keys(Control + ",");
                activated => { root.current-view = "settings"; }
            }
            MenuItem {
                title: "全屏预览";
                shortcut: @keys(Control + Shift + F);
                activated => {
                    if (root.current-view == "profiles" && !root.modal-open) {
                        if (root.show-preview-viewer) {
                            root.show-preview-viewer = false;
                        } else {
                            root.open-preview-viewer();
                        }
                    }
                }
            }
        }
    }

    Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.window;
        VerticalLayout {
            width: 100%;
            height: 100%;
            spacing: 0;
            Rectangle {
                height: 52px;
                background: Theme.titlebar;
                HorizontalLayout {
                    padding-left: 22px;
                    padding-right: 22px;
                    spacing: 9px;
                    Rectangle {
                        width: 30px;
                        height: 52px;
                        Image {
                            source: root.icon;
                            width: 30px;
                            height: 30px;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                    Text {
                        text: "CrabHosts";
                        color: Theme.text;
                        font-size: 13px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
                Rectangle { y: 51px; width: 100%; height: 1px; background: Theme.border-soft; }
            }
            HorizontalLayout {
                vertical-stretch: 1;
                spacing: 0;
                Rectangle {
                    width: root.sidebar-width;
                    background: Theme.sidebar;
                    VerticalLayout {
                        padding-top: root.compact-height ? 18px : 24px;
                        padding-bottom: 18px;
                        padding-left: root.compact-width ? 12px : 16px;
                        padding-right: root.compact-width ? 12px : 16px;
                        spacing: 0;
                        HorizontalLayout {
                            height: 36px;
                            spacing: 8px;
                            Text {
                                text: "Profiles";
                                color: Theme.text;
                                font-size: 20px;
                                font-weight: 650;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            Rectangle {
                                width: max(22px, profile-count.preferred-width + 12px);
                                height: 20px;
                                border-radius: 10px;
                                border-width: 1px;
                                border-color: Theme.border;
                                profile-count := Text {
                                    text: root.profiles.length + "";
                                    color: Theme.muted;
                                    font-size: 11px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                            IconButton {
                                icon: @image-url("assets/plus.svg");
                                accessible-name: "新建";
                                clicked => {
                                    root.new-profile-name = "";
                                    root.import-from-system = false;
                                    root.create-error = "";
                                    root.show-create = true;
                                }
                            }
                            IconButton {
                                icon: @image-url("assets/refresh.svg");
                                accessible-name: "刷新";
                                clicked => root.refresh();
                            }
                        }
                        Rectangle { height: root.compact-height ? 12px : 18px; }
                        Rectangle {
                            vertical-stretch: 1;
                            if root.profiles.length == 0 : VerticalLayout {
                                alignment: center;
                                spacing: 6px;
                                Text {
                                    text: "还没有 Profile";
                                    color: Theme.text-soft;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: "点击 + 新建";
                                    color: Theme.muted;
                                    font-size: 12px;
                                    horizontal-alignment: center;
                                }
                            }
                            ListView {
                                width: 100%;
                                height: 100%;
                                for profile[index] in root.profiles : ProfileRow {
                                    height: root.density-compact ? 54px : root.compact-height ? 61px : 67px;
                                    profile-name: profile.name;
                                    entry-count: profile.entry-count;
                                    selected: profile.selected;
                                    compact: root.compact-height || root.density-compact;
                                    show-counts: root.pref-show-profile-counts;
                                    clicked => {
                                        root.current-view = "profiles";
                                        root.profile-selected(index);
                                        root.panel-mode = 0;
                                        root.preview-selected();
                                    }
                                }
                            }
                        }
                        Rectangle { height: 8px; }
                        Rectangle {
                            height: 34px;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Theme.border-soft;
                            background: Theme.surface;
                            HorizontalLayout {
                                padding-left: 9px;
                                padding-right: 5px;
                                spacing: 7px;
                                Rectangle {
                                    width: 5px;
                                    height: 5px;
                                    y: 14px;
                                    border-radius: 3px;
                                    background: root.helper-state == "ready" ? Theme.sage :
                                        root.helper-state == "unavailable" ? Theme.danger :
                                        root.helper-state == "checking" ? Theme.muted : Theme.ivory;
                                }
                                Text {
                                    text: root.helper-display-text;
                                    color: Theme.muted;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                                if root.helper-actionable : AppButton {
                                    text: root.helper-busy ? "处理中…" : "安装/更新";
                                    small: true;
                                    button-height: 26px;
                                    enabled: !root.helper-busy;
                                    clicked => { root.show-helper-install = true; }
                                }
                            }
                        }
                        Rectangle { height: 8px; }
                        Rectangle {
                            height: 84px;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: Theme.border-soft;
                            background: Theme.surface;
                            HorizontalLayout {
                                padding: 12px;
                                spacing: 9px;
                                Image {
                                    source: @image-url("assets/shield.svg");
                                    width: 15px;
                                    height: 15px;
                                    y: 2px;
                                    colorize: Theme.text-soft;
                                }
                                Text {
                                    text: "Profile 修改不会自动更改系统 hosts，应用前始终需要确认。";
                                    color: Theme.muted;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                    horizontal-stretch: 1;
                                }
                            }
                        }
                        Rectangle { height: 14px; }
                        HorizontalLayout {
                            height: 40px;
                            spacing: 8px;
                            AppButton {
                                text: "查看系统 hosts";
                                icon: @image-url("assets/file.svg");
                                show-icon: true;
                                button-height: 40px;
                                horizontal-stretch: 1;
                                clicked => {
                                    root.panel-mode = 1;
                                    root.load-system-hosts();
                                    root.open-preview-viewer();
                                }
                            }
                            IconButton {
                                icon: @image-url("assets/settings.svg");
                                accessible-name: "打开设置";
                                button-size: 40px;
                                clicked => { root.current-view = "settings"; }
                            }
                        }
                    }
                    Rectangle { x: root.sidebar-width - 1px; width: 1px; height: 100%; background: Theme.border-soft; }
                }
                if root.current-view == "profiles" && root.selected-name == "" : Rectangle {
                    horizontal-stretch: 1;
                    background: Theme.window;
                    VerticalLayout {
                        alignment: center;
                        spacing: 12px;
                        padding: 24px;
                        Text {
                            text: "还没有选择 Profile";
                            color: Theme.text;
                            font-size: 20px;
                            font-weight: 650;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "新建一个 Profile，或把当前系统 hosts 中的记录导入为 Profile。";
                            color: Theme.muted;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            alignment: center;
                            spacing: 10px;
                            AppButton {
                                text: "新建 Profile";
                                kind: "primary";
                                clicked => {
                                    root.new-profile-name = "";
                                    root.import-from-system = false;
                                    root.create-error = "";
                                    root.show-create = true;
                                }
                            }
                            AppButton {
                                text: "从系统 hosts 导入";
                                clicked => {
                                    root.new-profile-name = "";
                                    root.import-from-system = true;
                                    root.create-error = "";
                                    root.show-create = true;
                                }
                            }
                        }
                    }
                }
                if root.current-view == "profiles" && root.selected-name != "" : main-scroll := ScrollView {
                    horizontal-stretch: 1;
                    height: 100%;
                    HorizontalLayout {
                        width: main-scroll.width;
                        height: root.content-height;
                        alignment: center;
                        VerticalLayout {
                            width: min(1500px, main-scroll.width);
                            height: root.content-height;
                            padding-top: root.content-padding-top;
                            padding-bottom: root.content-padding-bottom;
                            padding-left: root.compact-width ? 20px : 28px;
                            padding-right: root.compact-width ? 20px : 28px;
                            spacing: root.content-gap;
                            HorizontalLayout {
                                height: 54px;
                                spacing: root.compact-width ? 12px : 20px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 7px;
                                    Text {
                                        text: "当前 PROFILE";
                                        color: Theme.muted;
                                        font-size: 11px;
                                        font-weight: 600;
                                    }
                                    HorizontalLayout {
                                        spacing: 12px;
                                        Text {
                                            text: root.selected-name;
                                            color: Theme.text;
                                            font-size: 28px;
                                            font-weight: 650;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                        }
                                        if !root.compact-width : Text {
                                            text: root.entries.length + " 条记录 · " + root.selected-enabled-count + " 条已启用";
                                            color: Theme.muted;
                                            font-size: 12px;
                                            vertical-alignment: bottom;
                                        }
                                    }
                                }
                                AppButton {
                                    text: "删除";
                                    icon: @image-url("assets/trash.svg");
                                    show-icon: true;
                                    kind: "danger";
                                    clicked => { root.show-delete-confirm = true; }
                                }
                                AppButton {
                                    text: "预览变更";
                                    icon: @image-url("assets/eye.svg");
                                    show-icon: true;
                                    clicked => {
                                        root.panel-mode = 0;
                                        root.preview-selected();
                                    }
                                }
                                AppButton {
                                    text: root.selected-in-sync ? "已同步" : "应用到本机";
                                    icon: @image-url("assets/check.svg");
                                    show-icon: true;
                                    kind: "apply";
                                    enabled: !root.helper-busy && !root.selected-in-sync;
                                    clicked => { root.request-apply(); }
                                }
                            }
                            Rectangle {
                                height: root.entries-height;
                                border-radius: 14px;
                                border-width: 1px;
                                border-color: Theme.border-soft;
                                background: Theme.surface;
                                clip: true;
                                VerticalLayout {
                                    spacing: 0;
                                    HorizontalLayout {
                                        height: 54px;
                                        padding-left: 18px;
                                        padding-right: 18px;
                                        spacing: 10px;
                                        Text {
                                            text: "Hosts 记录";
                                            color: Theme.text;
                                            font-size: 14px;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: "管理当前 Profile 中的映射";
                                            color: Theme.muted;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                        }
                                        Rectangle {
                                            width: 15px;
                                            height: 54px;
                                            Image {
                                                source: @image-url("assets/info.svg");
                                                width: 15px;
                                                height: 15px;
                                                y: (parent.height - self.height) / 2;
                                                colorize: Theme.muted;
                                            }
                                        }
                                        Text {
                                            text: "仅保存到 Profile";
                                            color: Theme.muted;
                                            font-size: 11px;
                                            vertical-alignment: center;
                                        }
                                    }
                                    Rectangle { height: 1px; background: Theme.border-soft; }
                                    HorizontalLayout {
                                        height: 38px;
                                        spacing: 0;
                                        Rectangle { width: 82px; Text { x: 18px; text: "状态"; color: Theme.muted; font-size: 11px; vertical-alignment: center; } }
                                        Rectangle { width: 152px; Text { x: 14px; text: "IP 地址"; color: Theme.muted; font-size: 11px; vertical-alignment: center; } }
                                        Rectangle { horizontal-stretch: 1; Text { x: 14px; text: "Hostname"; color: Theme.muted; font-size: 11px; vertical-alignment: center; } }
                                        Rectangle { width: root.compact-width ? 110px : 156px; Text { x: 14px; text: "备注"; color: Theme.muted; font-size: 11px; vertical-alignment: center; } }
                                        Rectangle { width: 58px; }
                                    }
                                    Rectangle { height: 1px; background: Theme.border-soft; }
                                    Rectangle {
                                        vertical-stretch: 1;
                                        if root.entries.length == 0 : Text {
                                            text: "这个 Profile 还没有记录，请在下方添加。";
                                            color: Theme.muted;
                                            font-size: 13px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                        ListView {
                                            width: 100%;
                                            height: 100%;
                                            for entry[index] in root.entries : Rectangle {
                                                height: root.density-compact ? 46px : 58px;
                                                background: row-hover.has-hover ? Theme.raised : transparent;
                                                row-hover := TouchArea {}
                                                HorizontalLayout {
                                                    spacing: 0;
                                                    Rectangle {
                                                        width: 82px;
                                                        EntrySwitch {
                                                            x: 18px;
                                                            y: (parent.height - 20px) / 2;
                                                            on: entry.enabled;
                                                            accessible-name: (entry.enabled ? "禁用 " : "启用 ") + entry.hostnames;
                                                            clicked => root.toggle-entry(index);
                                                        }
                                                    }
                                                    Rectangle {
                                                        width: 152px;
                                                        Text {
                                                            x: 14px;
                                                            width: parent.width - 28px;
                                                            text: entry.address;
                                                            color: entry.enabled ? Theme.text-soft : Theme.faint;
                                                            font-family: "SF Mono";
                                                            font-size: 13px;
                                                            vertical-alignment: center;
                                                            overflow: elide;
                                                        }
                                                    }
                                                    Rectangle {
                                                        horizontal-stretch: 1;
                                                        Text {
                                                            x: 14px;
                                                            width: parent.width - 28px;
                                                            text: entry.hostnames;
                                                            color: entry.enabled ? Theme.text : Theme.faint;
                                                            font-family: "SF Mono";
                                                            font-size: 13px;
                                                            font-weight: 500;
                                                            vertical-alignment: center;
                                                            overflow: elide;
                                                        }
                                                    }
                                                    Rectangle {
                                                        width: root.compact-width ? 110px : 156px;
                                                        Text {
                                                            x: 14px;
                                                            width: parent.width - 28px;
                                                            text: entry.comment == "" ? "—" : entry.comment;
                                                            color: entry.enabled ? Theme.muted : Theme.faint;
                                                            font-size: 13px;
                                                            vertical-alignment: center;
                                                            overflow: elide;
                                                        }
                                                    }
                                                    Rectangle {
                                                        width: 58px;
                                                        IconButton {
                                                            x: 7px;
                                                            y: (parent.height - 30px) / 2;
                                                            icon: @image-url("assets/trash.svg");
                                                            accessible-name: "删除 " + entry.hostnames;
                                                            button-size: 30px;
                                                            icon-size: 15px;
                                                            danger: true;
                                                            clicked => {
                                                                root.pending-entry = index;
                                                                root.show-remove-entry = true;
                                                            }
                                                        }
                                                    }
                                                }
                                                if index < root.entries.length - 1 : Rectangle {
                                                    y: parent.height - 1px;
                                                    width: 100%;
                                                    height: 1px;
                                                    background: Theme.hover;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            Rectangle {
                                height: 126px;
                                border-radius: 14px;
                                border-width: 1px;
                                border-color: Theme.border-soft;
                                background: Theme.surface;
                                VerticalLayout {
                                    padding-top: 15px;
                                    padding-bottom: 17px;
                                    padding-left: root.compact-width ? 14px : 18px;
                                    padding-right: root.compact-width ? 14px : 18px;
                                    spacing: 0;
                                    HorizontalLayout {
                                        height: 23px;
                                        spacing: 8px;
                                        Rectangle {
                                            width: 15px;
                                            height: 23px;
                                            Image {
                                                source: @image-url("assets/plus.svg");
                                                width: 15px;
                                                height: 15px;
                                                y: (parent.height - self.height) / 2;
                                                colorize: Theme.text-soft;
                                            }
                                        }
                                        Text { text: "添加记录"; color: Theme.text-soft; font-size: 12px; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
                                        if !root.compact-width : Text { text: "多个 Hostname 使用空格分隔"; color: Theme.faint; font-size: 11px; vertical-alignment: center; }
                                    }
                                    Rectangle { height: 12px; }
                                    HorizontalLayout {
                                        height: 59px;
                                        spacing: root.compact-width ? 8px : 10px;
                                        Rectangle {
                                            horizontal-stretch: 0.8;
                                            min-width: root.compact-width ? 125px : 140px;
                                            VerticalLayout {
                                                spacing: 6px;
                                                Text { text: "IP 地址"; color: Theme.muted; font-size: 11px; height: 13px; }
                                                FieldInput {
                                                    text <=> root.draft-ip;
                                                    placeholder: "127.0.0.1";
                                                    accessible-name: "IP 地址";
                                                    mono: true;
                                                    submitted => root.submit-entry();
                                                }
                                            }
                                        }
                                        Rectangle {
                                            horizontal-stretch: 1.8;
                                            min-width: root.compact-width ? 170px : 210px;
                                            VerticalLayout {
                                                spacing: 6px;
                                                Text { text: "Hostname"; color: Theme.muted; font-size: 11px; height: 13px; }
                                                FieldInput {
                                                    text <=> root.draft-hostnames;
                                                    placeholder: "api.local web.local";
                                                    accessible-name: "Hostname，多个使用空格分隔";
                                                    mono: true;
                                                    submitted => root.submit-entry();
                                                }
                                            }
                                        }
                                        Rectangle {
                                            horizontal-stretch: 0.85;
                                            min-width: root.compact-width ? 110px : 130px;
                                            VerticalLayout {
                                                spacing: 6px;
                                                Text { text: "备注（可选）"; color: Theme.muted; font-size: 11px; height: 13px; }
                                                FieldInput {
                                                    text <=> root.draft-comment;
                                                    placeholder: "用途说明";
                                                    accessible-name: "备注（可选）";
                                                    submitted => root.submit-entry();
                                                }
                                            }
                                        }
                                        Rectangle {
                                            width: 108px;
                                            height: 59px;
                                            AppButton {
                                                y: 19px;
                                                width: 108px;
                                                text: "添加记录";
                                                enabled: root.draft-valid;
                                                icon: @image-url("assets/plus.svg");
                                                show-icon: true;
                                                kind: "primary";
                                                button-height: 40px;
                                                clicked => root.submit-entry();
                                            }
                                        }
                                    }
                                }
                            }
                            Rectangle {
                                height: root.preview-height;
                                border-radius: 14px;
                                border-width: 1px;
                                border-color: Theme.border-soft;
                                background: Theme.surface;
                                clip: true;
                                VerticalLayout {
                                    spacing: 0;
                                    HorizontalLayout {
                                        height: 50px;
                                        padding-left: 18px;
                                        padding-right: 14px;
                                        spacing: 10px;
                                        VerticalLayout {
                                            height: 50px;
                                            alignment: center;
                                            Rectangle {
                                                height: 37px;
                                                border-radius: 9px;
                                                border-width: 1px;
                                                border-color: Theme.border-soft;
                                                background: Theme.field;
                                                HorizontalLayout {
                                                    padding: 3px;
                                                    spacing: 3px;
                                                    Segment {
                                                        text: "差异预览";
                                                        active: root.panel-mode == 0;
                                                        clicked => {
                                                            root.panel-mode = 0;
                                                            root.preview-selected();
                                                        }
                                                    }
                                                    Segment {
                                                        text: "系统 hosts";
                                                        active: root.panel-mode == 1;
                                                        clicked => {
                                                            root.panel-mode = 1;
                                                            root.load-system-hosts();
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                        Text {
                                            text: root.panel-stats;
                                            color: Theme.faint;
                                            font-size: 11px;
                                            vertical-alignment: center;
                                        }
                                        Rectangle {
                                            width: 15px;
                                            height: 50px;
                                            Image {
                                                source: @image-url("assets/lock.svg");
                                                width: 15px;
                                                height: 15px;
                                                y: (parent.height - self.height) / 2;
                                                colorize: Theme.muted;
                                            }
                                        }
                                        Text { text: "只读"; color: Theme.muted; font-size: 11px; vertical-alignment: center; }
                                        VerticalLayout {
                                            height: 50px;
                                            alignment: center;
                                            AppButton {
                                                text: "从系统 hosts 导入";
                                                icon: @image-url("assets/import.svg");
                                                show-icon: true;
                                                kind: "quiet";
                                                small: true;
                                                // 导入会合并并落盘 Profile，先确认再执行，避免误点直接改数据。
                                                clicked => { root.show-import-confirm = true; }
                                            }
                                        }
                                        VerticalLayout {
                                            height: 50px;
                                            alignment: center;
                                            if root.viewer-opened && !root.show-preview-viewer : Rectangle {
                                                width: 0;
                                                height: 0;
                                                init => { preview-expand.focus(); }
                                            }
                                            preview-expand := AppButton {
                                                text: "全屏";
                                                icon: @image-url("assets/expand.svg");
                                                show-icon: true;
                                                kind: "quiet";
                                                small: true;
                                                accessible-name: "全屏查看差异预览";
                                                clicked => { root.open-preview-viewer(); }
                                            }
                                        }
                                    }
                                    Rectangle { height: 1px; background: Theme.border-soft; }
                                    Rectangle {
                                        vertical-stretch: 1;
                                        background: Theme.field;
                                        clip: true;
                                        VerticalLayout {
                                            padding-top: 6px;
                                            for line[index] in root.preview-lines : Rectangle {
                                                height: index < root.preview-inline-lines ? 22px : 0px;
                                                visible: index < root.preview-inline-lines;
                                                background: line.kind == "add" ? #80977814 : line.kind == "remove" ? #a66c6314 : transparent;
                                                HorizontalLayout {
                                                    spacing: 0;
                                                    Text {
                                                        width: 46px;
                                                        text: line.line-number + "";
                                                        color: Theme.faint;
                                                        font-family: "SF Mono";
                                                        font-size: 12px;
                                                        horizontal-alignment: right;
                                                        vertical-alignment: center;
                                                    }
                                                    Rectangle { width: 13px; }
                                                    Text {
                                                        text: line.text == "" ? " " : line.text;
                                                        color: line.kind == "add" ? Theme.sage : line.kind == "remove" ? Theme.danger : Theme.text-soft;
                                                        font-family: "SF Mono";
                                                        font-size: 12px;
                                                        vertical-alignment: center;
                                                        wrap: no-wrap;
                                                        horizontal-stretch: 1;
                                                    }
                                                }
                                            }
                                            if root.preview-lines.length == 0 : VerticalLayout {
                                                padding: 18px;
                                                Text {
                                                    text: root.panel-text == "" ? "选择“差异预览”生成差异，或选择“系统 hosts”查看原文。" : root.panel-text;
                                                    color: Theme.text-soft;
                                                    font-family: "SF Mono";
                                                    font-size: 12px;
                                                    wrap: no-wrap;
                                                }
                                            }
                                        }
                                        Rectangle {
                                            y: parent.height - self.height;
                                            width: 100%;
                                            height: 10px;
                                            background: @linear-gradient(180deg, #00000000 0%, Theme.field 100%);
                                        }
                                    }
                                    Rectangle {
                                        height: 30px;
                                        background: Theme.sidebar;
                                        Rectangle { y: 0; width: 100%; height: 1px; background: Theme.border-soft; }
                                        HorizontalLayout {
                                            padding-left: 18px;
                                            padding-right: 14px;
                                            spacing: 8px;
                                            Text {
                                                text: root.panel-line-count <= root.preview-inline-lines
                                                    ? "共 " + root.panel-line-count + " 行 · 已全部显示"
                                                    : "共 " + root.panel-line-count + " 行 · 仅显示前 " + root.preview-inline-lines + " 行";
                                                color: Theme.faint;
                                                font-size: 11px;
                                                vertical-alignment: center;
                                                horizontal-stretch: 1;
                                            }
                                            AppButton {
                                                text: "全屏查看";
                                                icon: @image-url("assets/expand.svg");
                                                show-icon: true;
                                                kind: "quiet";
                                                small: true;
                                                button-height: 24px;
                                                accessible-name: "全屏查看完整预览";
                                                clicked => { root.open-preview-viewer(); }
                                            }
                                        }
                                    }
                                }
                            }
                            HorizontalLayout {
                                height: 20px;
                                spacing: 8px;
                                Rectangle { width: 5px; height: 5px; y: 7px; border-radius: 3px; background: Theme.sage; }
                                Text {
                                    text: root.status;
                                    color: Theme.muted;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                                Text { text: "系统 hosts："; color: Theme.faint; font-size: 11px; vertical-alignment: center; }
                                Text {
                                    text: root.system-hosts-path;
                                    color: Theme.muted;
                                    font-family: "SF Mono";
                                    font-size: 11px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    max-width: 300px;
                                }
                            }
                        }
                    }
                }
                if root.current-view == "settings" : SettingsView {
                    horizontal-stretch: 1;
                    height: 100%;
                    section: root.settings-section;
                    launch-at-login: root.pref-launch-at-login;
                    show-tray: root.pref-show-tray;
                    close-action: root.pref-close-action;
                    density: root.pref-density;
                    show-profile-counts: root.pref-show-profile-counts;
                    reduce-motion: root.pref-reduce-motion;
                    backup-retention: root.pref-backup-retention;
                    backup-path: root.backup-path;
                    app-version: root.app-version;
                    login-item-status: root.login-item-status;
                    close => { root.current-view = "profiles"; }
                    section-selected(index) => { root.settings-section = index; }
                    preference-changed(key, value) => { root.preference-changed(key, value); }
                    open-backups => { root.open-backups(); }
                    show-safety => { root.show-safety = true; }
                    reset-preferences => { root.show-reset-preferences = true; }
                }
            }
        }
    }

    if root.show-create : ModalFrame {
        title: "新建 Profile";
        kicker: "PROFILE";
        close => { root.show-create = false; }
        VerticalLayout {
            padding-top: 16px;
            padding-bottom: 22px;
            padding-left: 24px;
            padding-right: 24px;
            spacing: 7px;
            Text { text: "Profile 名称（1–64 个字符）"; color: Theme.text-soft; font-size: 12px; }
            FieldInput {
                text <=> root.new-profile-name;
                placeholder: "例如：开发环境";
                accessible-name: "Profile 名称";
                height: 42px;
                submitted => root.create-profile(root.new-profile-name, root.import-from-system);
            }
            Text {
                text: root.create-error;
                color: Theme.danger;
                font-size: 12px;
                height: 18px;
                wrap: word-wrap;
            }
            Rectangle { height: 2px; }
            AppCheckBox {
                checked <=> root.import-from-system;
                label: "导入当前系统 hosts 中的记录";
                description: "只读取并写入 Profile，不会修改系统 hosts。";
            }
        }
        ModalFooter {
            AppButton { text: "取消"; kind: "quiet"; clicked => { root.show-create = false; } }
            AppButton {
                text: "创建 Profile";
                kind: "primary";
                clicked => root.create-profile(root.new-profile-name, root.import-from-system);
            }
        }
    }

    if root.show-delete-confirm : ModalFrame {
        title: "删除 Profile「" + root.selected-name + "」？";
        kicker: "删除确认";
        close => { root.show-delete-confirm = false; }
        VerticalLayout {
            padding-top: 16px;
            padding-bottom: 22px;
            padding-left: 24px;
            padding-right: 24px;
            Text {
                text: "只删除 CrabHosts 保存的配置，不会修改系统 hosts，也不会删除已生成的备份。";
                color: Theme.text-soft;
                font-size: 13px;
                wrap: word-wrap;
            }
        }
        ModalFooter {
            AppButton { text: "取消"; kind: "quiet"; clicked => { root.show-delete-confirm = false; } }
            AppButton {
                text: "确认删除";
                kind: "danger";
                clicked => {
                    root.show-delete-confirm = false;
                    root.delete-profile();
                }
            }
        }
    }

    if root.show-remove-entry : ModalFrame {
        title: "删除这条记录？";
        kicker: "删除确认";
        close => {
            root.show-remove-entry = false;
            root.pending-entry = -1;
        }
        VerticalLayout {
            padding-top: 16px;
            padding-bottom: 22px;
            padding-left: 24px;
            padding-right: 24px;
            spacing: 14px;
            Text {
                text: "将从当前 Profile 中移除 " + root.pending-entry-summary + "。";
                color: Theme.text-soft;
                font-size: 13px;
                wrap: word-wrap;
            }
            Text {
                text: "不会修改系统 hosts，该操作无法撤销。";
                color: Theme.text-soft;
                font-size: 13px;
                wrap: word-wrap;
            }
        }
        ModalFooter {
            AppButton {
                text: "取消";
                kind: "quiet";
                clicked => {
                    root.show-remove-entry = false;
                    root.pending-entry = -1;
                }
            }
            AppButton {
                text: "确认删除";
                kind: "danger";
                clicked => {
                    root.show-remove-entry = false;
                    root.remove-entry(root.pending-entry);
                    root.pending-entry = -1;
                }
            }
        }
    }

    if root.show-import-confirm : ModalFrame {
        title: "导入系统 hosts 记录？";
        kicker: "导入确认";
        close => { root.show-import-confirm = false; }
        VerticalLayout {
            padding-top: 16px;
            padding-bottom: 22px;
            padding-left: 24px;
            padding-right: 24px;
            spacing: 12px;
            Text {
                text: "将把系统 hosts 中的记录合并到 Profile「" + root.selected-name + "」。";
                color: Theme.text-soft;
                font-size: 13px;
                wrap: word-wrap;
            }
            Text {
                text: "同 IP 且启用状态一致的记录会合并 Hostname；其余记录按新记录加入。";
                color: Theme.muted;
                font-size: 12px;
                wrap: word-wrap;
            }
            Text {
                text: "只会修改 CrabHosts 保存的 Profile，不会修改系统 hosts。";
                color: Theme.muted;
                font-size: 12px;
                wrap: word-wrap;
            }
        }
        ModalFooter {
            AppButton { text: "取消"; kind: "quiet"; clicked => { root.show-import-confirm = false; } }
            AppButton {
                text: "确认导入";
                kind: "primary";
                clicked => {
                    root.show-import-confirm = false;
                    root.import-selected-from-system();
                }
            }
        }
    }

    if root.show-confirm : ModalFrame {
        title: "确认应用到本机？";
        kicker: "系统 HOSTS";
        close => {
            if (!root.helper-busy) {
                root.show-confirm = false;
                root.apply-cancelled();
            }
        }
        VerticalLayout {
            padding-top: 16px;
            padding-bottom: 22px;
            padding-left: 24px;
            padding-right: 24px;
            spacing: 12px;
            Text {
                text: "将把 Profile「" + root.selected-name + "」应用到系统 hosts。";
                color: Theme.text-soft;
                font-size: 13px;
                wrap: word-wrap;
            }
            HorizontalLayout {
                height: 64px;
                spacing: 10px;
                SummaryCell { horizontal-stretch: 1; label: "启用记录"; value: root.selected-enabled-count + " 条"; }
                SummaryCell { horizontal-stretch: 1; label: "目标文件"; value: root.system-hosts-path; mono: true; }
            }
            VerticalLayout {
                spacing: 9px;
                CheckLine { text: "只替换 CrabHosts 托管区块，保留其他内容"; }
                CheckLine { text: "写入前自动创建备份"; }
                CheckLine {
                    text: root.helper-state == "direct" ?
                        "直接写入（测试/演示）：需要当前用户具备目标文件及目录的写权限，不会隐式提权。" :
                        root.helper-state == "unsupported" ?
                        "当前平台不支持系统写入 Helper，不能通过此流程应用。" :
                        "通过系统写入 Helper 完成；仅安装/更新 Helper 时需要管理员授权，日常应用不再询问密码。";
                }
            }
            if !root.apply-allowed : Text {
                text: root.helper-busy ? "Helper 正在处理，请稍候。" :
                    root.helper-state == "unsupported" ? "当前平台不支持此写入方式。" :
                    root.helper-state == "direct" ? "当前写入流程不可用。" :
                    "请先从侧栏安装或更新系统写入 Helper，再重新预览并确认应用。";
                color: Theme.danger;
                font-size: 12px;
                wrap: word-wrap;
            }
        }
        ModalFooter {
            AppButton {
                text: "取消";
                kind: "quiet";
                enabled: !root.helper-busy;
                clicked => {
                    root.show-confirm = false;
                    root.apply-cancelled();
                }
            }
            AppButton {
                text: root.helper-busy ? "正在应用…" : "确认应用";
                kind: "primary";
                enabled: root.apply-allowed;
                clicked => {
                    root.show-confirm = false;
                    root.apply-selected();
                }
            }
        }
    }

    if root.show-helper-install : ModalFrame {
        title: root.helper-state == "not_installed" ? "安装系统写入 Helper？" : "安装或更新系统写入 Helper？";
        kicker: "一次性管理员授权";
        close => { if (!root.helper-busy) { root.show-helper-install = false; } }
        VerticalLayout {
            padding-top: 16px;
            padding-bottom: 22px;
            padding-left: 24px;
            padding-right: 24px;
            spacing: 12px;
            Text {
                text: "CrabHosts 将通过系统安装或更新最小权限写入 Helper。macOS 会请求一次管理员授权。";
                color: Theme.text-soft;
                font-size: 13px;
                wrap: word-wrap;
            }
            CheckLine { text: "此操作只安装或更新 Helper，不会修改系统 hosts。"; }
            CheckLine { text: "日常应用仍需确认差异和备份，但不再重复询问管理员密码。"; }
            CheckLine { text: "不会在应用启动或点击应用时自动安装 Helper。"; }
        }
        ModalFooter {
            AppButton {
                text: "取消";
                kind: "quiet";
                enabled: !root.helper-busy;
                clicked => { root.show-helper-install = false; }
            }
            AppButton {
                text: root.helper-busy ? "正在处理…" : "安装/更新 Helper";
                kind: "primary";
                enabled: !root.helper-busy;
                clicked => {
                    root.show-helper-install = false;
                    root.install-helper();
                }
            }
        }
    }

    if root.show-safety : ModalFrame {
        title: "安全与事实边界";
        kicker: "CRABHOSTS";
        wide: true;
        close => { root.show-safety = false; }
        VerticalLayout {
            padding-top: 16px;
            padding-bottom: 22px;
            padding-left: 24px;
            padding-right: 24px;
            spacing: 12px;
            CheckLine { text: "Profile 编辑与 Tray 切换不会隐式修改系统 hosts"; }
            CheckLine { text: "真实写入需要最新差异计划、显式确认与自动备份"; }
            CheckLine { text: "Helper 仅在安装或更新时请求管理员授权，日常写入不重复询问密码"; }
            Text {
                text: "桌面偏好只保存在本机 preferences.json，不进入 Profile 同步文档。备份保留数量只在桌面端成功应用后清理最旧的受管自动备份。";
                color: Theme.muted;
                font-size: 12px;
                wrap: word-wrap;
            }
        }
        ModalFooter {
            AppButton { text: "知道了"; kind: "primary"; clicked => { root.show-safety = false; } }
        }
    }

    if root.show-reset-preferences : ModalFrame {
        title: "恢复默认偏好设置？";
        kicker: "设置";
        close => { root.show-reset-preferences = false; }
        VerticalLayout {
            padding-top: 16px;
            padding-bottom: 22px;
            padding-left: 24px;
            padding-right: 24px;
            spacing: 12px;
            Text {
                text: "只重置启动、Tray、外观与备份保留数量等桌面偏好。";
                color: Theme.text-soft;
                font-size: 13px;
                wrap: word-wrap;
            }
            Text {
                text: "不会删除 Profile，也不会修改系统 hosts。备份只在后续成功应用时按保留数量清理。";
                color: Theme.muted;
                font-size: 12px;
                wrap: word-wrap;
            }
        }
        ModalFooter {
            AppButton { text: "取消"; kind: "quiet"; clicked => { root.show-reset-preferences = false; } }
            AppButton {
                text: "恢复默认";
                kind: "primary";
                clicked => {
                    root.show-reset-preferences = false;
                    root.reset-preferences();
                }
            }
        }
    }

    if root.show-preview-viewer : FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.close-preview-viewer();
                accept
            } else {
                reject
            }
        }
        Rectangle {
            width: 100%;
            height: 100%;
            background: #050605bd;
            TouchArea { clicked => { root.close-preview-viewer(); } }
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: min(1180px, root.width - (root.compact-width ? 32px : 48px));
                height: min(860px, root.height - (root.compact-height ? 32px : 48px));
                border-radius: 16px;
                border-width: 1px;
                border-color: Theme.border;
                background: Theme.surface;
                clip: true;
                drop-shadow-blur: 70px;
                drop-shadow-color: #00000080;
                drop-shadow-offset-y: 24px;
                TouchArea {}
                VerticalLayout {
                    spacing: 0;
                    Rectangle {
                        height: root.compact-height ? 60px : 68px;
                        background: Theme.surface;
                        HorizontalLayout {
                            padding-left: 22px;
                            padding-right: 18px;
                            spacing: 16px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 6px;
                                alignment: center;
                                Text {
                                    text: "只读预览 · 不会写入系统 hosts";
                                    color: Theme.muted;
                                    font-size: 11px;
                                }
                                HorizontalLayout {
                                    spacing: 10px;
                                    Text {
                                        text: root.panel-mode == 0 ? "差异预览" : "系统 hosts";
                                        color: Theme.text;
                                        font-size: 19px;
                                        font-weight: 650;
                                        vertical-alignment: center;
                                    }
                                    Rectangle {
                                        width: max(28px, min(240px, viewer-profile.preferred-width + 20px));
                                        height: 22px;
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: Theme.border;
                                        background: transparent;
                                        clip: true;
                                        viewer-profile := Text {
                                            width: parent.width;
                                            text: root.panel-mode == 0 ? root.selected-name : root.system-hosts-path;
                                            color: Theme.text-soft;
                                            font-size: 11px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }
                                    Rectangle {
                                        width: 15px;
                                        height: 22px;
                                        Image {
                                            source: @image-url("assets/lock.svg");
                                            width: 15px;
                                            height: 15px;
                                            y: (parent.height - self.height) / 2;
                                            colorize: Theme.muted;
                                        }
                                    }
                                    Text { text: "只读"; color: Theme.muted; font-size: 11px; vertical-alignment: center; }
                                }
                            }
                            CenteredControl {
                                Rectangle {
                                    width: 34px;
                                    height: 22px;
                                    border-radius: 5px;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    background: Theme.field;
                                    Text {
                                        text: "Esc";
                                        color: Theme.muted;
                                        font-size: 10px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                            CenteredControl {
                                IconButton {
                                    icon: @image-url("assets/close.svg");
                                    accessible-name: "关闭全屏预览";
                                    clicked => { root.close-preview-viewer(); }
                                }
                            }
                        }
                    }
                    Rectangle { height: 1px; background: Theme.border-soft; }
                    Rectangle {
                        height: root.compact-height ? 46px : 52px;
                        background: Theme.sidebar;
                        HorizontalLayout {
                            padding-left: 22px;
                            padding-right: 18px;
                            spacing: 12px;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    height: 37px;
                                    border-radius: 9px;
                                    border-width: 1px;
                                    border-color: Theme.border-soft;
                                    background: Theme.field;
                                    HorizontalLayout {
                                        padding: 3px;
                                        spacing: 3px;
                                        Segment {
                                            text: "差异预览";
                                            active: root.panel-mode == 0;
                                            clicked => {
                                                root.panel-mode = 0;
                                                root.preview-selected();
                                            }
                                        }
                                        Segment {
                                            text: "系统 hosts";
                                            active: root.panel-mode == 1;
                                            clicked => {
                                                root.panel-mode = 1;
                                                root.load-system-hosts();
                                            }
                                        }
                                    }
                                }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            CenteredControl {
                                AppButton {
                                    text: "自动换行";
                                    icon: @image-url("assets/wrap.svg");
                                    show-icon: true;
                                    kind: root.preview-wrap ? "secondary" : "quiet";
                                    small: true;
                                    accessible-name: "自动换行";
                                    clicked => { root.preview-wrap = !root.preview-wrap; }
                                }
                            }
                            CenteredControl {
                                AppButton {
                                    text: "行号";
                                    icon: @image-url("assets/hash.svg");
                                    show-icon: true;
                                    kind: root.preview-gutter ? "secondary" : "quiet";
                                    small: true;
                                    accessible-name: "显示行号";
                                    clicked => { root.preview-gutter = !root.preview-gutter; }
                                }
                            }
                            CenteredControl {
                                AppButton {
                                    text: "复制";
                                    icon: @image-url("assets/copy.svg");
                                    show-icon: true;
                                    kind: "quiet";
                                    small: true;
                                    accessible-name: "复制预览内容";
                                    clicked => { root.copy-preview(); }
                                }
                            }
                        }
                    }
                    Rectangle { height: 1px; background: Theme.border-soft; }
                    Rectangle {
                        vertical-stretch: 1;
                        background: Theme.field;
                        ScrollView {
                            width: 100%;
                            height: 100%;
                            VerticalLayout {
                                padding-top: 10px;
                                padding-bottom: 20px;
                                padding-left: 8px;
                                padding-right: 14px;
                                for line in root.preview-lines : Rectangle {
                                    height: root.preview-wrap ? max(22px, viewer-line.preferred-height) : 22px;
                                    background: line.kind == "add" ? #80977814 : line.kind == "remove" ? #a66c6314 : transparent;
                                    viewer-line := HorizontalLayout {
                                        spacing: 0;
                                        if root.preview-gutter : Text {
                                            width: 56px;
                                            text: line.line-number + "";
                                            color: Theme.faint;
                                            font-family: "SF Mono";
                                            font-size: 12px;
                                            horizontal-alignment: right;
                                            vertical-alignment: top;
                                        }
                                        if root.preview-gutter : Rectangle { width: 8px; }
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            Text {
                                                text: line.text == "" ? " " : line.text;
                                                color: line.kind == "add" ? Theme.sage : line.kind == "remove" ? Theme.danger : Theme.text-soft;
                                                font-family: "SF Mono";
                                                font-size: 12px;
                                                vertical-alignment: top;
                                                wrap: root.preview-wrap ? word-wrap : no-wrap;
                                            }
                                        }
                                    }
                                }
                                if root.preview-lines.length == 0 : VerticalLayout {
                                    padding: 18px;
                                    Text {
                                        text: root.panel-text == "" ? "选择“差异预览”生成差异，或选择“系统 hosts”查看原文。" : root.panel-text;
                                        color: Theme.text-soft;
                                        font-family: "SF Mono";
                                        font-size: 12px;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                        }
                    }
                    Rectangle {
                        height: 46px;
                        background: Theme.sidebar;
                        Rectangle { y: 0; width: 100%; height: 1px; background: Theme.border-soft; }
                        HorizontalLayout {
                            padding-left: 20px;
                            padding-right: 20px;
                            spacing: 9px;
                            Rectangle { width: 5px; height: 5px; border-radius: 3px; background: Theme.sage; }
                            Text {
                                text: root.panel-mode == 0
                                    ? "只读预览 · 修改仍需回到主窗口确认应用"
                                    : "只读预览 · 系统 hosts 原文不会被修改";
                                color: Theme.muted;
                                font-size: 11px;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: root.panel-stats;
                                color: Theme.text-soft;
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "系统 hosts：" + root.system-hosts-path;
                                color: Theme.faint;
                                font-size: 11px;
                                vertical-alignment: center;
                                overflow: elide;
                                max-width: 300px;
                            }
                        }
                    }
                }
            }
        }
    }

    Timer {
        interval: 2600ms;
        running: root.toast-visible;
        triggered => { root.toast-visible = false; }
    }
    if root.toast-visible : Rectangle {
        x: (root.width - self.width) / 2;
        y: root.height - self.height - 28px;
        width: min(root.width - 40px, toast-layout.preferred-width);
        height: 42px;
        border-radius: 10px;
        border-width: 1px;
        border-color: Theme.secondary-border;
        background: Theme.raised;
        drop-shadow-blur: 36px;
        drop-shadow-color: #00000059;
        drop-shadow-offset-y: 12px;
        toast-layout := HorizontalLayout {
            padding-left: 15px;
            padding-right: 15px;
            spacing: 9px;
            alignment: center;
            Rectangle {
                width: 15px;
                height: 42px;
                Image {
                    source: @image-url("assets/check.svg");
                    width: 15px;
                    height: 15px;
                    y: (parent.height - self.height) / 2;
                    colorize: Theme.sage;
                }
            }
            Text {
                text: root.toast-text;
                color: Theme.text;
                font-size: 13px;
                vertical-alignment: center;
                overflow: elide;
                max-width: root.width - 100px;
            }
        }
    }
}
