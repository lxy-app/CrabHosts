import { Button, HorizontalBox, VerticalBox, ListView, ScrollView } from "std-widgets.slint";

export struct ProfileData {
    name: string,
    entry-count: int,
    selected: bool,
}

export struct EntryData {
    address: string,
    hostnames: string,
    enabled: bool,
    comment: string,
}

export component MainWindow inherits Window {
    title: "CrabHosts";
    preferred-width: 960px;
    preferred-height: 640px;
    min-width: 760px;
    min-height: 480px;

    in property <[ProfileData]> profiles;
    in property <[EntryData]> entries;
    in property <string> selected-name;
    in property <string> status;
    in property <string> diff;
    property <bool> show-confirm: false;

    callback refresh();
    callback profile-selected(int);
    callback preview-selected();
    callback apply-selected();

    HorizontalBox {
        padding: 16px;
        spacing: 16px;

        VerticalBox {
            width: 260px;
            spacing: 10px;
            HorizontalLayout {
                Text {
                    text: "Profiles";
                    font-size: 22px;
                    font-weight: 700;
                    horizontal-stretch: 1;
                }
                Button {
                    text: "刷新";
                    clicked => root.refresh();
                }
            }
            Rectangle {
                background: #f3f4f6;
                border-radius: 8px;
                vertical-stretch: 1;
                ListView {
                    for profile[index] in root.profiles: Rectangle {
                        height: 54px;
                        background: profile.selected ? #dbeafe : transparent;
                        border-radius: 6px;
                        TouchArea {
                            clicked => root.profile-selected(index);
                        }
                        VerticalLayout {
                            padding: 9px;
                            spacing: 2px;
                            Text {
                                text: profile.name;
                                font-weight: 600;
                                color: #111827;
                            }
                            Text {
                                text: profile.entry-count + " 条记录";
                                font-size: 12px;
                                color: #6b7280;
                            }
                        }
                    }
                }
            }
            Text {
                text: "Profile 修改不会自动更改系统 hosts";
                wrap: word-wrap;
                font-size: 12px;
                color: #6b7280;
            }
        }

        VerticalBox {
            horizontal-stretch: 1;
            spacing: 10px;
            Text {
                text: root.selected-name == "" ? "请选择 Profile" : root.selected-name;
                font-size: 22px;
                font-weight: 700;
            }
            HorizontalLayout {
                spacing: 8px;
                Button {
                    text: "预览变更";
                    enabled: root.selected-name != "";
                    clicked => root.preview-selected();
                }
                Button {
                    text: "应用到本机";
                    primary: true;
                    enabled: root.selected-name != "";
                    clicked => {
                        root.show-confirm = true;
                    }
                }
            }
            Rectangle {
                background: #ffffff;
                border-color: #e5e7eb;
                border-width: 1px;
                border-radius: 8px;
                vertical-stretch: 1;
                ListView {
                    for entry in root.entries: VerticalLayout {
                        padding: 8px;
                        HorizontalLayout {
                            spacing: 12px;
                            Text {
                                text: entry.enabled ? "●" : "○";
                                color: entry.enabled ? #059669 : #9ca3af;
                                vertical-alignment: center;
                            }
                            Text {
                                text: entry.address;
                                width: 140px;
                                font-family: "monospace";
                                vertical-alignment: center;
                            }
                            Text {
                                text: entry.hostnames;
                                horizontal-stretch: 1;
                                font-family: "monospace";
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Text {
                                text: entry.comment;
                                color: #6b7280;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
            Text {
                text: "差异预览（只读）";
                font-size: 13px;
                font-weight: 600;
            }
            Rectangle {
                height: 150px;
                background: #111827;
                border-radius: 8px;
                ScrollView {
                    VerticalLayout {
                        padding: 10px;
                        Text {
                            text: root.diff == "" ? "点击“预览变更”生成差异。" : root.diff;
                            color: #d1d5db;
                            font-family: "monospace";
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                }
            }
            Text {
                text: root.status;
                wrap: word-wrap;
                color: #4b5563;
                font-size: 12px;
            }
        }
    }

    if root.show-confirm: Rectangle {
        width: 100%;
        height: 100%;
        background: #00000088;
        TouchArea {}
        Rectangle {
            width: 460px;
            height: 190px;
            background: #ffffff;
            border-radius: 12px;
            VerticalBox {
                padding: 22px;
                spacing: 16px;
                Text {
                    text: "确认修改本机系统 hosts？";
                    font-size: 19px;
                    font-weight: 700;
                }
                Text {
                    text: "CrabHosts 只替换自己的托管区块，并在写入前自动备份。当前用户必须有目标文件及目录的写权限。";
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 10px;
                    Button {
                        text: "取消";
                        clicked => {
                            root.show-confirm = false;
                        }
                    }
                    Button {
                        text: "确认应用";
                        primary: true;
                        clicked => {
                            root.show-confirm = false;
                            root.apply-selected();
                        }
                    }
                }
            }
        }
    }
}
